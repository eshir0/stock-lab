# ─────────────────────────────────────────────────────────────
# Stock Lab 설정 예시. 복사해서 .env로 저장하세요. (.env는 절대 커밋 금지)
# setup.sh가 비어 있는 APP_PASSWORD / SESSION_SECRET / POSTGRES_PASSWORD를 무작위로 채웁니다.
# ─────────────────────────────────────────────────────────────

# ── 접속·보안 ─────────────────────────────────────────────────
APP_PASSWORD=
SESSION_SECRET=
POSTGRES_PASSWORD=
# 앱을 바인딩할 LAN 주소. 8080 포트를 인터넷에 직접 열지 마세요(리버스 프록시 사용).
APP_HOST=127.0.0.1
# 리버스 프록시 뒤 공개 주소(HTTPS). 예: https://stock.example.com
APP_PUBLIC_ORIGIN=

# ── 시세 ──────────────────────────────────────────────────────
# demo: 합성 시세 + 고정 응답(외부 호출 없음) / toss: 토스증권 조회 API 실시세
MARKET_MODE=demo
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# 미국 종목 소수점 거래(4자리, 주문당 최소 약 1달러)를 모의체결에 허용합니다. 시뮬레이션 가정입니다. off면 정수 주식만
FRACTIONAL_US=on

# 호가는 종목마다 한 번씩 호출해야 해서 병렬로 조회합니다 (1~8)
TOSS_PARALLEL=4

# ── AI 공급자 순서 (앞에서부터 시도, 소진·실패 시 다음으로) ───────
# Gemini는 무료 등급이 검색이 안 되고 불안정해 기본 구성에서 뺐습니다. 쓰려면 claude,codex,gemini 로 바꾸세요.
AI_PROVIDERS=claude,codex
# 구독 사용률(5시간·주간 창)이 이 값(%)에 닿으면 분석을 시작하기 전에 다음 AI로 전환합니다 (10~99)
AI_SWITCH_AT_PCT=80

# 호스트 중계 서비스(bridge/ai_bridge.py) — claude -p / codex exec 실행
AI_BRIDGE_URL=http://host.docker.internal:8765
AI_BRIDGE_BIND=172.17.0.1:8765
# 64자 무작위 값: python3 -c "import secrets;print(secrets.token_hex(32))"
AI_BRIDGE_TOKEN=

# Claude Code CLI (구독 로그인 사용)
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
CLAUDE_EFFORT=medium
# 조사 역할(AI_LIGHT_ROLES)이 쓰는 가벼운 모델. 비우면 모든 역할이 위 주력 모델을 씁니다(중계 서비스가 요청마다 읽음)
CLAUDE_MODEL_LIGHT=claude-sonnet-5-5
# 가벼운 모델로 돌릴 역할: 업무 배정·기업·시세·뉴스 분석. 종목 선정·반대 검토·최종 판단은 주력 모델. 비우면 분담하지 않음
AI_LIGHT_ROLES=planner,fundamental,technical,news

# Codex CLI (ChatGPT 로그인 사용)
CODEX_MODEL=gpt-6.1-sol
# low | medium | high | xhigh | max
CODEX_EFFORT=high

# Gemini API (선택 · AI_PROVIDERS에 gemini를 넣었을 때만 사용)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Gemini 3.x: low | medium | high
GEMINI_THINKING=high
# 무료 등급은 Google 검색 불가 → off
GEMINI_SEARCH=off
# Gemini 호출에만 적용되는 하루 한도(UTC)
AI_DAILY_CALL_LIMIT=30

# ── 주기 ──────────────────────────────────────────────────────
ANALYSIS_INTERVAL_SECONDS=1200
# AI 구독 창이 위 간격대로 쓰면 금방 바닥나면, 세션이 끝날 때까지 쓸 수 있는 횟수를 고르게 나눠 간격을 늘립니다(위 값이 최소 간격). off면 항상 위 간격
QUOTA_PACING=on
# 조절해서 늘릴 수 있는 최대 간격(초)
PACE_MAX_SECONDS=4500
# 조건부 자동 진입: AI가 관망하면서 "이 가격에 닿으면 매수" 계획을 남기면 서버가 AI 호출 없이 호가만 감시하다가 같은 위험 규칙으로 모의매수합니다. off면 계획을 저장하지 않습니다
CONDITIONAL_ENTRY=on
# 조사 재사용: 같은 종목을 이 시간(초) 안에 다시 분석하면 앞선 업무 배정·기업·뉴스 조사를 다시 쓰고 시세 분석·반대 검토·최종 판단만 새로 합니다(AI 호출 6회 → 3회). 0이면 끔. 가격이 조사 때보다 아래 비율(%) 이상 움직이거나 거래량이 급증하면 새로 조사합니다
RESEARCH_REUSE_SECONDS=3600
RESEARCH_REUSE_MOVE_PCT=1.5
# 최소 익절 폭: 매수 계획의 익절 폭(%)이 왕복 비용(수수료·슬리피지·국내 매도세·호가 스프레드)의 이 배수 미만이면 서버가 매수와 조건 진입을 거부합니다. 비용에 잡아먹히는 좁은 목표를 막습니다. 0이면 끔
MIN_TAKE_COST_RATIO=3
QUOTE_POLL_SECONDS=10

# ── 오늘의 집중 종목 ──────────────────────────────────────────
# 시장별 개수 (1~6)
FOCUS_PER_MARKET=3
# off이면 AI 뉴스 브리핑 없이 일봉 데이터만으로 선정
FOCUS_AI=on

# ── 매매 비용 (2026년 실제 요율, 1bp = 0.01%) ──────────────────────
# 실제 요율(2026년, 토스증권): 국내 수수료 0.015% = 1.5bp, 미국 0.1% = 10bp(주문 10달러 이하 무료),
# 국내 주식 매도 거래세 0.20% = 20bp(ETF는 면제, 서버가 종목별로 적용). 슬리피지는 호가 스프레드에 더하는 가정
FEE_KR_BPS=1.5
FEE_US_BPS=10
SELL_TAX_KR_BPS=20
SLIPPAGE_BPS=5

# ── 실거래 준비 (구조만 · 이 빌드에서는 항상 잠김) ─────────────────
# LIVE_TRADING=on 이라고 써도 이 빌드는 무시합니다 (코드 상수 잠금). 화면에 "무시" 사유가 표시됩니다.
LIVE_TRADING=off
LIVE_ALLOW_BUY=off
LIVE_ALLOW_SELL=off
# 실거래였다면 나갔을 주문을 기록만 함 (on/off)
SHADOW_MODE=on
# 절대 금액 한도: 자리표시자입니다. 실거래 전에 반드시 본인 원금에 맞게 조정하세요.
LIVE_MAX_ORDER_KRW=100000
LIVE_MAX_ORDER_USD=100
LIVE_MAX_DAILY_NOTIONAL_KRW=300000
LIVE_MAX_DAILY_NOTIONAL_USD=300
LIVE_MAX_DAILY_LOSS_KRW=30000
LIVE_MAX_DAILY_LOSS_USD=30
LIVE_MAX_POSITION_KRW=200000
LIVE_MAX_POSITION_USD=200
LIVE_MAX_DAILY_ORDERS=10
LIVE_MAX_OPEN_ORDERS=3
# 지정가가 기준가에서 이 비율(%)을 넘게 벗어나면 착오로 보고 차단
LIVE_PRICE_BAND_PCT=1
# 허용 종목 (레버리지 ETF는 일부러 뺐음). 비워 두면 아무 종목도 허용하지 않음
LIVE_ALLOWED_SYMBOLS=005930,000660,AAPL,MSFT
# 휴대폰 알림(선택): 새 체결과 경고를 이 주소로 평문 POST. 예) ntfy 앱에서 구독할 길고 무작위한 주제: https://ntfy.sh/stocklab-길고-무작위한-이름
# 비우면 보내지 않습니다. 공개 서버의 주제 이름은 아는 사람은 누구나 구독할 수 있으니 짐작하기 어렵게 지으세요
NOTIFY_URL=
