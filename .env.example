# ─────────────────────────────────────────────────────────────
# Stock Lab 설정 예시. 복사해서 .env로 저장하세요. (.env는 절대 커밋 금지)
# setup.sh가 비어 있는 APP_PASSWORD / SESSION_SECRET / POSTGRES_PASSWORD를 무작위로 채웁니다.
# ─────────────────────────────────────────────────────────────

# ── 접속·보안 ─────────────────────────────────────────────────
APP_PASSWORD=
SESSION_SECRET=
POSTGRES_PASSWORD=
# 앱을 바인딩할 LAN 주소. 8080 포트를 인터넷에 직접 열지 마세요(리버스 프록시 사용).
APP_HOST=127.0.0.1
# 리버스 프록시 뒤 공개 주소(HTTPS). 예: https://stock.example.com
APP_PUBLIC_ORIGIN=

# ── 시세 ──────────────────────────────────────────────────────
# demo: 합성 시세 + 고정 응답(외부 호출 없음) / toss: 토스증권 조회 API 실시세
MARKET_MODE=demo
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# ── AI 공급자 순서 (앞에서부터 시도, 소진·실패 시 다음으로) ───────
AI_PROVIDERS=claude,codex,gemini

# 호스트 중계 서비스(bridge/ai_bridge.py) — claude -p / codex exec 실행
AI_BRIDGE_URL=http://host.docker.internal:8765
AI_BRIDGE_BIND=172.17.0.1:8765
# 64자 무작위 값: python3 -c "import secrets;print(secrets.token_hex(32))"
AI_BRIDGE_TOKEN=

# Claude Code CLI (구독 로그인 사용)
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
CLAUDE_EFFORT=medium

# Codex CLI (ChatGPT 로그인 사용)
CODEX_MODEL=gpt-6-sol
# low | medium | high | xhigh | max
CODEX_EFFORT=medium

# Gemini API (마지막 대체 수단)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Gemini 3.x: low | medium | high
GEMINI_THINKING=high
# 무료 등급은 Google 검색 불가 → off
GEMINI_SEARCH=off
# Gemini 호출에만 적용되는 하루 한도(UTC)
AI_DAILY_CALL_LIMIT=30

# ── 주기 ──────────────────────────────────────────────────────
ANALYSIS_INTERVAL_SECONDS=900
QUOTE_POLL_SECONDS=10

# ── 모의체결 비용 가정 (실제 증권사 요율 아님, 1bp = 0.01%) ───────
FEE_KR_BPS=15
FEE_US_BPS=15
SELL_TAX_KR_BPS=0
SLIPPAGE_BPS=5
