[Unit]
Description=Stock Lab AI bridge (claude -p / codex exec for the app container)
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/stock-lab
Environment=HOME=/root
Environment=PATH=/root/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 /opt/stock-lab/bridge/ai_bridge.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
